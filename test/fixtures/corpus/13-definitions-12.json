{
  "rabbit_version": "3.13.7",
  "rabbitmq_version": "3.12.13",
  "users": [
    {
      "name": "guest",
      "password_hash": "h1",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": [
        "administrator"
      ]
    },
    {
      "name": "svc-0",
      "password_hash": "h0",
