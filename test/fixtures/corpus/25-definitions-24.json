{
  "rabbit_version": "3.12.13",
  "rabbitmq_version": "3.12.13",
  "users": [
    {
      "name": "svc-0",
      "password_hash": "h0",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": []
    }
  ],
  "vhosts": [
    {
      "name": "/"
    }
  ],
  "permissions": [
    {
      "user": "svc-0",
      "vhost": "/",
      "configure": "^svc-.*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "topic_permissions": [],
  "parameters": [],
  "global_parameters": [],
  "policies": [
    {
      "vhost": "/",
      "name": "p1",
      "pattern": "^orders\\.",
      "apply-to": "all",
      "definition": {
        "ha-mode": "all"
      },
      "priority": 0
    }
  ],
  "queues": [
    {
      "name": "payments.root.0",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    },
    {
      "name": "payments.root.1",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-dead-letter-exchange": "orders.0"
      }
    }
  ],
  "exchanges": [
    {
      "name": "orders.0",
      "vhost": "/",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "audit.1",
      "vhost": "/",
      "type": "headers",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "missing.exchange",
      "vhost": "/",
      "destination": "payments.root.0",
      "destination_type": "queue",
      "routing_key": "order.created",
      "arguments": {}
    },
    {
      "source": "audit.1",
      "vhost": "/",
      "destination": "ghost.queue",
      "destination_type": "queue",
      "routing_key": "",
      "arguments": {}
    },
    {
      "source": "orders.0",
      "vhost": "/",
      "destination": "amq.topic",
      "destination_type": "exchange",
      "routing_key": "x",
      "arguments": {}
    }
  ]
}