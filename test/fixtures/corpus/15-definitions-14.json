{
  "rabbit_version": "3.12.13",
  "rabbitmq_version": "3.13.7",
  "users": [
    {
      "name": "svc-0",
      "password_hash": "",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": []
    },
    {
      "name": "svc-1",
      "password_hash": "h1",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": []
    },
    {
      "name": "svc-2",
      "password_hash": "h2",
      "hashing_algorithm": "rabbit_password_hashing_md5",
      "tags": "monitoring"
    }
  ],
  "vhosts": [
    {
      "name": "/"
    },
    {
      "name": "shop"
    }
  ],
  "permissions": [
    {
      "user": "svc-0",
      "vhost": "/",
      "configure": "^svc-.*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "topic_permissions": [],
  "parameters": [],
  "global_parameters": [],
  "policies": [
    {
      "vhost": "/",
      "name": "p1",
      "pattern": "([bad",
      "apply-to": "all",
      "definition": {
        "message-ttl": 60000
      },
      "priority": 0
    }
  ],
  "queues": [
    {
      "name": "payments.root.0",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "quorum"
      }
    },
    {
      "name": "orders.root.1",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "audit.shop.0",
      "vhost": "shop",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "stream"
      }
    },
    {
      "name": "audit.shop.1",
      "vhost": "shop",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "stream"
      }
    }
  ],
  "exchanges": [
    {
      "name": "orders.0",
      "vhost": "/",
      "type": "headers",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "mail.0",
      "vhost": "shop",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "orders.0",
      "vhost": "/",
      "destination": "payments.root.0",
      "destination_type": "queue",
      "routing_key": "#",
      "arguments": {}
    },
    {
      "source": "orders.0",
      "vhost": "/",
      "destination": "orders.root.1",
      "destination_type": "queue",
      "routing_key": "order.created",
      "arguments": {}
    },
    {
      "source": "missing.exchange",
      "vhost": "shop",
      "destination": "audit.shop.0",
      "destination_type": "queue",
      "routing_key": "order.created",
      "arguments": {}
    },
    {
      "source": "missing.exchange",
      "vhost": "shop",
      "destination": "audit.shop.1",
      "destination_type": "queue",
      "routing_key": "order.created",
      "arguments": {}
    }
  ]
}