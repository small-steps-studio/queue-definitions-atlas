{
  "rabbit_version": "3.12.13",
  "rabbitmq_version": "4.0.5",
  "users": [
    {
      "name": "guest",
      "password_hash": "h1",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": [
        "administrator"
      ]
    },
    {
      "name": "svc-0",
      "password_hash": "h0",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": []
    },
    {
      "name": "svc-1",
      "password_hash": "h1",
      "hashing_algorithm": "rabbit_password_hashing_sha256",
      "tags": [
        "administrator"
      ]
    }
  ],
  "vhosts": [
    {
      "name": "/"
    },
    {
      "name": "shop"
    },
    {
      "name": "billing"
    }
  ],
  "permissions": [
    {
      "user": "svc-0",
      "vhost": "/",
      "configure": "^svc-.*",
      "write": ".*",
      "read": ".*"
    },
    {
      "user": "svc-1",
      "vhost": "shop",
      "configure": "^svc-.*",
      "write": ".*",
      "read": ".*"
    },
    {
      "user": "svc-0",
      "vhost": "billing",
      "configure": "^svc-.*",
      "write": ".*",
      "read": ".*"
    }
  ],
  "topic_permissions": [],
  "parameters": [],
  "global_parameters": [],
  "policies": [],
  "queues": [
    {
      "name": "orders.root.0",
      "vhost": "/",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    },
    {
      "name": "audit.shop.0",
      "vhost": "shop",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-queue-type": "stream",
        "x-dead-letter-exchange": "dlx"
      }
    },
    {
      "name": "audit.billing.0",
      "vhost": "billing",
      "durable": true,
      "auto_delete": false,
      "arguments": {}
    }
  ],
  "exchanges": [
    {
      "name": "events.0",
      "vhost": "/",
      "type": "fanout",
      "durable": true,
      "auto_delete": false,
      "internal": true,
      "arguments": {}
    },
    {
      "name": "mail.0",
      "vhost": "shop",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "audit.0",
      "vhost": "billing",
      "type": "direct",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "orders.1",
      "vhost": "billing",
      "type": "headers",
      "durable": true,
      "auto_delete": false,
      "internal": true,
      "arguments": {}
    },
    {
      "name": "mail.2",
      "vhost": "billing",
      "type": "direct",
      "durable": false,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "bindings": [
    {
      "source": "events.0",
      "vhost": "/",
      "destination": "orders.root.0",
      "destination_type": "queue",
      "routing_key": "mail.*",
      "arguments": {}
    },
    {
      "source": "mail.0",
      "vhost": "shop",
      "destination": "amq.topic",
      "destination_type": "exchange",
      "routing_key": "x",
      "arguments": {}
    },
    {
      "source": "audit.0",
      "vhost": "billing",
      "destination": "amq.topic",
      "destination_type": "exchange",
      "routing_key": "x",
      "arguments": {}
    }
  ]
}